# Copy to deploy/.env on the server and fill in. deploy/.env is git-ignored: never commit it.
# Generate each secret with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# (letters, digits, - and _ only, so it is safe inside the database URL).

# The site's address, without https:// (its DNS A record must point at this server).
DOMAIN=agrictec.example.com

POSTGRES_PASSWORD=
SECRET_KEY=

# Your Super Admin sign-in (required in production). Password: 10+ characters with upper- and
# lower-case letters, a number and a symbol.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# API worker processes (about 2 per CPU core).
# WEB_CONCURRENCY=2
# ADMIN_IDLE_MINUTES=30

# ---- Optional services: each stays off while empty (see the backend repository's README) ----
# Paystack webhook URL to set in the dashboard: https://DOMAIN/api/v1/payments/paystack/webhook
# Without a key, only the Free plan can be chosen in production.
PAYSTACK_SECRET_KEY=
ARKESEL_API_KEY=
# SMS_SENDER_ID=AgriCtec
SMTP_HOST=
# SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMILE_ID_PARTNER_ID=
SMILE_ID_API_KEY=
# SMILE_ID_SANDBOX=true
# Claude: the assistant and the crop doctor (each question or scan is a paid API request).
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
