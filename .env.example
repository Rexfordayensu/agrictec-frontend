# Copy to .env and fill in. .env is git-ignored: never commit real credentials.

# Where the AgriCtec API (backend/) runs. The app calls /api/v1 on its own origin and Next.js
# forwards it here, so the API's httpOnly session cookies belong to this site.
BACKEND_URL=http://127.0.0.1:8000

# Only to call the API on another origin directly (then list this app in the API's CORS_ORIGINS).
# NEXT_PUBLIC_API_URL=https://api.example.com/api/v1

# Minutes of inactivity before an admin is signed out. Keep it equal to the API's
# ADMIN_IDLE_MINUTES (default 30 for both).
# NEXT_PUBLIC_ADMIN_IDLE_MINUTES=30

# The owner's Super Admin sign-in is now set on the API: ADMIN_EMAIL and ADMIN_PASSWORD in
# backend/.env (see backend/.env.example).
