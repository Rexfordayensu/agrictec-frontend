# Copy to backend/.env and fill in. .env is git-ignored: never commit real credentials.

ENVIRONMENT=development

# PostgreSQL. Create the database first, e.g.:  createdb -U postgres agrictec
DATABASE_URL=postgresql+psycopg2://postgres:YOUR_PASSWORD@localhost:5432/agrictec

# Signs the guest device cookie. Production: a random value of 32+ characters, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-insecure-secret-change-me

# The Next.js app's origin(s), comma-separated (cookies need credentials, so never "*").
CORS_ORIGINS=http://localhost:3000

# true behind HTTPS (required in production). Set COOKIE_DOMAIN only to share across subdomains.
COOKIE_SECURE=false
# COOKIE_DOMAIN=

# Your own Super Admin sign-in. Leave both empty to use the demo super admin
# (superadmin@agrictec.app / Admin@2026, which must be changed at first sign-in).
# Password rules: 10+ characters with upper- and lower-case letters, a number and a symbol.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Minutes of inactivity before an admin is signed out, and the longest admin sign-in (hours).
ADMIN_IDLE_MINUTES=30
ADMIN_SESSION_HOURS=12
FARMER_SESSION_DAYS=30

# Seed the demo world (~60 farmers, 25 loans, verifications, risk flags) on first start.
# Never in production.
SEED_DEMO_DATA=true

# The app's public address, used in payment return links and emails.
PUBLIC_APP_URL=http://localhost:3000

# Rate limits on sign-in, sign-up, the assistant, crop doctor, weather and place search.
# Only these proxies' X-Forwarded-For is believed (the Next.js app forwards from this host).
RATE_LIMITS_ENABLED=true
TRUSTED_PROXIES=127.0.0.1,::1

# ---- Optional outside services. Each stays off until its keys are set. ----
# Weather (Open-Meteo) and market prices (WFP via HDX) are free and need no keys.

# Paystack: MTN MoMo, Telecel Cash, AirtelTigo Money and cards in GHS. Use sk_test_... first.
# In the Paystack dashboard, set the webhook URL to
#   https://YOUR_DOMAIN/api/v1/payments/paystack/webhook
# Without a key, plans use demo payments, which production refuses.
# PAYSTACK_SECRET_KEY=

# SMS via Arkesel. The sender ID (11 characters at most) must be approved by Arkesel.
# ARKESEL_API_KEY=
# SMS_SENDER_ID=AgriCtec

# Email over SMTP (any provider).
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=AgriCtec <no-reply@example.com>
# SMTP_STARTTLS=true

# Smile ID: Ghana Card checks against the NIA register, shown to the admin as advice.
# SMILE_ID_PARTNER_ID=
# SMILE_ID_API_KEY=
# SMILE_ID_SANDBOX=true
